    "/api/v1/admin/elements": {
      "get": {
        "tags": ["Admin"],
        "summary": "Daftar unsur (editor/admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar unsur" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Tambah unsur",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "atomicNumber",
                  "symbol",
                  "nameId",
                  "nameLatin",
                  "atomicMass",
                  "electronConfig",
                  "period",
                  "group",
                  "categoryId"
                ],
                "properties": {
                  "atomicNumber": { "type": "integer", "minimum": 1, "maximum": 118 },
                  "symbol": { "type": "string" },
                  "nameId": { "type": "string" },
                  "nameLatin": { "type": "string" },
                  "atomicMass": { "type": "number" },
                  "electronConfig": { "type": "string" },
                  "period": { "type": "integer", "minimum": 1, "maximum": 7 },
                  "group": { "type": "integer", "minimum": 1, "maximum": 18 },
                  "categoryId": { "type": "string", "format": "uuid" },
                  "description": { "type": "string" },
                  "uses": { "type": "string" },
                  "hazardWarning": { "type": "string" },
                  "meltingPoint": { "type": "number" },
                  "boilingPoint": { "type": "number" },
                  "density": { "type": "number" },
                  "electronegativity": { "type": "number", "minimum": 0, "maximum": 4 },
                  "ionizationEnergy": { "type": "number" },
                  "atomicRadius": { "type": "number" },
                  "covalentRadius": { "type": "number" },
                  "molarHeat": { "type": "number" },
                  "oxidationStates": { "type": "string" },
                  "phaseAtRoomTemp": { "type": "string" },
                  "block": { "type": "string" },
                  "appearance": { "type": "string" },
                  "discoveredBy": { "type": "string" },
                  "yearDiscovered": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Unsur dibuat" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "description": "Nomor atom atau simbol sudah dipakai" }
        }
      }
    },
