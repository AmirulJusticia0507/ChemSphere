{
  "version": 2,
  "installCommand": "npm ci --prefix frontend --include=dev --no-audit --no-fund && npm install --prefix backend --no-audit --no-fund",
  "buildCommand": "npm run vercel-build --prefix backend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/api/v1/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/{src,prisma}/**,docs/openapi.json"
    }
  }
}
