# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL - Neon cloud)
# Ganti dengan connection string Neon milikmu, contoh:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.c-#.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET=ganti-dengan-kunci-rahasia-yang-kuat
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ganti-dengan-kunci-refresh-yang-berbeda

# App
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Seed admin (ubah untuk produksi)
SEED_ADMIN_EMAIL=admin@chemsphere.local
SEED_ADMIN_PASSWORD=ChemSphere123!

# Observability
LOG_LEVEL=info
# Endpoint pelaporan error (opsional). Kosongkan untuk menonaktifkan.
ERROR_REPORTING_URL=
ERROR_REPORTING_TOKEN=
