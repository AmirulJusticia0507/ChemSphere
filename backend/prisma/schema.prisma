generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  password      String   @db.VarChar(255)
  role          UserRole @default(user)
  isActive      Boolean  @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  refreshToken  String?  @map("refresh_token") @db.Text
  bookmarks     Bookmark[]
  quizAttempts  QuizAttempt[]
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("users")
}

enum UserRole {
  user
  editor
  admin

  @@map("user_role")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  elements  Element[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("categories")
}

model Element {
  id                String     @id @default(uuid()) @db.Uuid
  atomicNumber      Int        @unique @db.Integer
  symbol            String     @unique @db.VarChar(10)
  nameId            String     @db.VarChar(100)
  nameLatin         String     @db.VarChar(100)
  atomicMass        Decimal    @db.Decimal(10, 4)
  electronConfig    String     @db.VarChar(255)
  categoryId        String     @db.Uuid
  period            Int        @db.Integer
  group             Int        @db.Integer
  description       String?    @db.Text
  uses              String?    @db.Text
  hazardWarning     String?    @db.Text

  // Properti fisika dan kimia
  meltingPoint      Decimal?   @map("melting_point") @db.Decimal(10, 3)
  boilingPoint      Decimal?   @map("boiling_point") @db.Decimal(10, 3)
  density           Decimal?   @db.Decimal(12, 6)
  electronegativity Decimal?   @db.Decimal(5, 3)
  ionizationEnergy  Decimal?   @map("ionization_energy") @db.Decimal(10, 3)
  atomicRadius      Decimal?   @map("atomic_radius") @db.Decimal(8, 3)
  covalentRadius    Decimal?   @map("covalent_radius") @db.Decimal(8, 3)
  molarHeat         Decimal?   @map("molar_heat") @db.Decimal(8, 3)
  oxidationStates   String?    @map("oxidation_states") @db.VarChar(100)
  phaseAtRoomTemp   String?    @map("phase_at_room_temp") @db.VarChar(20)
  block             String?    @db.VarChar(5)
  appearance        String?    @db.VarChar(255)
  discoveredBy      String?    @map("discovered_by") @db.VarChar(150)
  yearDiscovered    Int?       @map("year_discovered") @db.Integer

  category          Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isotopes          Isotope[]
  bookmarks         Bookmark[]
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  @@map("elements")
}

model Isotope {
  id            String   @id @default(uuid()) @db.Uuid
  elementId     String   @map("element_id") @db.Uuid
  massNumber    Int      @map("mass_number") @db.Integer
  abundance     Decimal? @db.Decimal(8, 4)
  halfLife      String?  @map("half_life") @db.VarChar(50)
  isRadioactive Boolean  @default(false) @map("is_radioactive")
  element       Element  @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([elementId, massNumber])
  @@map("isotopes")
}

model PolyatomicIon {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  formula     String   @db.VarChar(50)
  charge      String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("polyatomic_ions")
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  elementId String   @map("element_id") @db.Uuid
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  element Element @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([userId, elementId])
  @@index([userId])
  @@map("bookmarks")
}

model QuizAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  topic       String   @db.VarChar(50)
  total       Int      @db.Integer
  correct     Int      @db.Integer
  score       Int      @db.Integer
  durationSec Int?     @map("duration_sec") @db.Integer
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("quiz_attempts")
}
